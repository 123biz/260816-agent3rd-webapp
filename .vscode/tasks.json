{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Project Terminal",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoExit", "-Command", "Set-Location -LiteralPath '${workspaceFolder}'"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
